rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().data.role == 'super_admin'
        && adminDoc().data.active == true;
    }

    function isSchoolAdminFor(schoolId) {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().data.role == 'school_admin'
        && adminDoc().data.active == true
        && adminDoc().data.schoolId == schoolId;
    }

    function ownsSchool(schoolId) {
      return signedIn()
        && exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerId == request.auth.uid;
    }

    function isActiveSchoolMember(schoolId) {
      return signedIn()
        && exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.status == 'active'
        && exists(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.schoolId == schoolId;
    }

    match /admins/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /userSchoolLinks/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isSuperAdmin();

      allow create: if (signedIn()
        && request.auth.uid == uid
        && request.resource.data.schoolId is string
        && request.resource.data.status == 'pending')
        || (isSuperAdmin()
        || (request.resource.data.schoolId is string
          && request.resource.data.status == 'active'
          && isSchoolAdminFor(request.resource.data.schoolId)
          && uid is string));

      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /schools/{schoolId} {
      allow read: if isSuperAdmin() || ownsSchool(schoolId) || isSchoolAdminFor(schoolId);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.id == schoolId;

      allow update: if isSuperAdmin()
        || (
          (ownsSchool(schoolId) || isSchoolAdminFor(schoolId))
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.status == resource.data.status
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.id == resource.data.id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'address',
            'phone',
            'email',
            'currency',
            'schoolYear',
            'matriculePrefix',
            'city',
            'province',
            'country',
            'updatedAt'
          ])
        );

      allow delete: if isSuperAdmin();

      match /users/{userId} {
        allow read: if isSuperAdmin()
          || isSchoolAdminFor(schoolId)
          || (signedIn() && request.auth.uid == userId && ownsSchool(schoolId));

        allow create: if isSuperAdmin()
          || isSchoolAdminFor(schoolId)
          || (
            signedIn()
            && request.auth.uid == userId
            && request.resource.data.schoolId == schoolId
            && request.resource.data.active == true
          );

        allow update: if isSuperAdmin()
          || isSchoolAdminFor(schoolId)
          || (
            signedIn()
            && request.auth.uid == userId
            && resource.data.schoolId == schoolId
            && request.resource.data.schoolId == schoolId
            && request.resource.data.role == resource.data.role
            && request.resource.data.active == resource.data.active
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName',
              'email',
              'updatedAt'
            ])
          );

        allow delete: if isSuperAdmin() || isSchoolAdminFor(schoolId);
      }

      match /sections/{sectionId} {
        allow read, write: if isSuperAdmin() || isActiveSchoolMember(schoolId);
      }

      match /classes/{classId} {
        allow read, write: if isSuperAdmin() || isActiveSchoolMember(schoolId);
      }

      match /options/{optionId} {
        allow read, write: if isSuperAdmin() || isActiveSchoolMember(schoolId);
      }

      match /students/{studentId} {
        allow read, write: if isSuperAdmin() || isActiveSchoolMember(schoolId);
      }

      match /feeTypes/{feeTypeId} {
        allow read, write: if isSuperAdmin() || isActiveSchoolMember(schoolId);
      }

      match /studentCharges/{chargeId} {
        allow read, write: if isSuperAdmin() || isActiveSchoolMember(schoolId);
      }

      match /payments/{paymentId} {
        allow read, write: if isSuperAdmin() || isActiveSchoolMember(schoolId);
      }

      match /paymentAllocations/{allocationId} {
        allow read, write: if isSuperAdmin() || isActiveSchoolMember(schoolId);
      }

      match /receipts/{receiptId} {
        allow read, write: if isSuperAdmin() || isActiveSchoolMember(schoolId);
      }

      match /cashOperations/{operationId} {
        allow read, write: if isSuperAdmin() || isActiveSchoolMember(schoolId);
      }

      match /auditLogs/{auditId} {
        allow read: if isSuperAdmin() || isActiveSchoolMember(schoolId);
        allow create: if isSuperAdmin() || isActiveSchoolMember(schoolId);
        allow update, delete: if false;
      }
    }
  }
}
