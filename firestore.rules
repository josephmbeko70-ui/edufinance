rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // A signed-in user may inspect only their own admin authorization record.
    // Writes remain forbidden from the client.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // School Root and Subcollections
    match /schools/{schoolId} {
      allow read, write: if isValidId(schoolId);

      match /users/{userId} {
        allow read, write: if isValidId(schoolId);
      }

      match /sections/{sectionId} {
        allow read, write: if isValidId(schoolId);
      }

      match /classes/{classId} {
        allow read, write: if isValidId(schoolId);
      }

      match /options/{optionId} {
        allow read, write: if isValidId(schoolId);
      }

      match /students/{studentId} {
        allow read, write: if isValidId(schoolId);
      }

      match /feeTypes/{feeTypeId} {
        allow read, write: if isValidId(schoolId);
      }

      match /studentCharges/{chargeId} {
        allow read, write: if isValidId(schoolId);
      }

      match /payments/{paymentId} {
        allow read, write: if isValidId(schoolId);
      }

      match /paymentAllocations/{allocationId} {
        allow read, write: if isValidId(schoolId);
      }

      match /receipts/{receiptId} {
        allow read, write: if isValidId(schoolId);
      }

      match /cashOperations/{operationId} {
        allow read, write: if isValidId(schoolId);
      }

      match /auditLogs/{auditId} {
        allow read, create: if isValidId(schoolId);
        allow update, delete: if false;
      }
    }
  }
}
